VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Vercel environment variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
SITE_ORIGIN=https://your-production-domain.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# GitHub Actions secret used by .github/workflows/supabase-migrations.yml.
# Use the Postgres connection string from Supabase project settings.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
