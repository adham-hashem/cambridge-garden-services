VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Vercel environment variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
SITE_ORIGIN=https://your-production-domain.com
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Cambridge Garden Services <bookings@your-verified-domain.com>
BOOKING_EMAIL_TO=admin@example.com

# GitHub Actions secret used by .github/workflows/supabase-migrations.yml.
# Use the Postgres connection string from Supabase project settings.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# AI Garden Designer (server-only; set these in Vercel, never commit real values).
# Stripe secret or restricted key (restricted key needs Checkout Sessions: write).
STRIPE_SECRET_KEY=sk_live_or_rk_live_your_stripe_key
# OpenAI key used for image generation.
OPENAI_API_KEY=your-openai-api-key
# Optional: defaults to gpt-image-1.
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional: separate secret (32+ chars) for customer sessions; falls back to ADMIN_SESSION_SECRET.
DESIGNER_SESSION_SECRET=generate-at-least-32-random-characters
